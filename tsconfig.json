{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* الحل والوحدات */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom"],
    "paths": { "@/*": ["./src/*"] },

    /* الصرامة — غير قابلة للتخفيف. نظام مالي لا يحتمل any ضمنيًا. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "vitest.rules.config.ts", "eslint.config.js"]
}
