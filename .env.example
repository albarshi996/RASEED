# ──────────────────────────────────────────────────────────────
# RASEED — إعدادات Firebase (بيئة التطوير المحلية)
# هذا الملف غير مُتتبَّع في git. لا تضع هنا أي سر حقيقي.
# مفاتيح Firebase للويب ليست أسرارًا — هي معرّفات عامة —
# والحماية الفعلية تأتي من Security Rules وتقييد مفتاح API.
# ──────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# المالك المعتمد الوحيد — يُملأ UID بعد أول تسجيل دخول
VITE_OWNER_EMAIL=
VITE_OWNER_UID=

# استخدام محاكي Firebase محليًا (true/false)
VITE_USE_EMULATORS=false
